# ========================================
# Mail Configuration
# ========================================
# Gmail account for sending emails
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ========================================
# Gemini API Configuration
# ========================================
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ========================================
# SePay Configuration
# ========================================
# Get from SePay Dashboard: https://my.sepay.vn

# API Token (Menu: Cài đặt → API Token)
SEPAY_API_TOKEN=your-sepay-api-token

# Webhook Secret (SePay uses API Token for webhook auth)
SEPAY_WEBHOOK_SECRET=your-sepay-webhook-secret

# Bank Account Info (Menu: Tài khoản ngân hàng)
SEPAY_BANK_ACCOUNT=your-bank-account-number
SEPAY_BANK_NAME=your-bank-account-name
SEPAY_BANK_CODE=your-bank-code
SEPAY_BANK_DISPLAY_NAME=your-bank-display-name
